<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
      No <monochrome> layer: the foreground is full-colour raster artwork, which Android 13+
      themed icons would flatten into a solid silhouette of the bulb, losing the check mark.
      Omitting it makes themed-icon launchers fall back to the standard adaptive icon.
    -->
</adaptive-icon>
