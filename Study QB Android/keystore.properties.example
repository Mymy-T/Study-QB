# Release signing credentials for the Play upload key.
#
# Copy this file to `keystore.properties` (which is gitignored) and fill in the real
# values. Without it, debug builds work normally but `bundleRelease`/`assembleRelease`
# produce an unsigned artifact that Play will reject.
#
# storeFile is resolved relative to the repository root.

storeFile=Keystore/keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
